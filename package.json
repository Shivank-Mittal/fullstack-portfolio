    "@fullcalendar/interaction": "^6.1.20",
    "@ngrx/signals": "^21.1.0",
    "@supabase/supabase-js": "^2.100.0",
    "express": "^5.1.0",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@angular/localize": "^21.2.4",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/express": "^5.0.1",
    "@types/node": "^18.18.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "prettier": "^3.8.2",
    "supabase": "^2.89.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
